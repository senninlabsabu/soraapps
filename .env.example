# ---- Supabase（Settings → API） ----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 更新トークンの暗号化に使う（長いランダムな文字列。変えると既存の連携は切れる）
APPS_ENCRYPTION_KEY=

# ---- 画像の保存先（Turso。元のソラチャットと同じ設定） ----
TURSO_DATABASE_URL=libsql://xxxxx.turso.io
TURSO_AUTH_TOKEN=

# ---- 仙人アカウント（OAuth） ----
# API（認可・トークン・userinfo・ポイント）の場所。Cloudflare Workers
SENNIN_BASE_URL=https://sennin-account-api.xianrendesu.workers.dev
# 仙人アカウントの画面（GAS）。開発者設定（アプリの登録）と新規登録の案内に使う。API には使わない
SENNIN_ACCOUNT_URL=https://script.google.com/macros/s/AKfycbyDgPuwdfDVrAMPruRnXFNlMzPWgwjbdxaRbzgdKqwr4EVfJESJcQviy9KmKExbtNJY/exec
SENNIN_CLIENT_ID=
SENNIN_CLIENT_SECRET=
# 仙人アカウントの開発者設定に登録したリダイレクトURIと完全一致させる（末尾のスラッシュ・大文字小文字も）
SENNIN_REDIRECT_URI=https://apps.example.com/api/auth/sennin/callback
# 既定: profile points:read points:write（points:write は仙人側の管理者の承認が必要）
# SENNIN_SCOPE=profile points:read points:write
# 通常は指定不要（SENNIN_BASE_URL から決まる）。個別に変えるときだけ指定する
# SENNIN_AUTHORIZATION_URL=
# SENNIN_TOKEN_URL=
# SENNIN_REVOKE_URL=
# SENNIN_USERINFO_URL=
# SENNIN_POINTS_URL=
# SENNIN_POINTS_ADJUST_URL=

# ---- アプリ ----
# このアプリの公開URL。必ず https:// から書く（例: https://soraapps.onrender.com）。https:// が無いと、戻り先が壊れます
APP_ORIGIN=https://apps.example.com
# 運営 API（/api/admin/...）のパスワード。画面はなく、curl -u admin:パスワード で使う。未設定なら無効
ADMIN_PASSWORD=
PORT=3000
